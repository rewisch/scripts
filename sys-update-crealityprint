#!/usr/bin/env bash

set -euo pipefail

OWNER="CrealityOfficial"
REPO="CrealityPrint"
API_LATEST="https://api.github.com/repos/${OWNER}/${REPO}/releases/latest"
TARGET_PATH="${TARGET_PATH:-/usr/bin/CrealityPrint.AppImage}"
STATE_PATH="${STATE_PATH:-/usr/bin/.CrealityPrint.AppImage.release}"
TMP_DIR="${TMPDIR:-/tmp}"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

run_as_root() {
  if [[ ${EUID} -eq 0 ]]; then
    "$@"
  else
    require_cmd sudo
    sudo "$@"
  fi
}

fetch_release_json() {
  if command -v gh >/dev/null 2>&1; then
    gh api "repos/${OWNER}/${REPO}/releases/latest"
    return
  fi

  require_cmd curl
  curl -fsSL \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -A 'crealityprint-updater' \
    "${API_LATEST}"
}

pick_asset_url() {
  local arch asset_filter
  arch="$(uname -m)"

  case "${arch}" in
    x86_64|amd64)
      asset_filter='
        .assets[]
        | select(.name | test("(?i)appimage"))
        | select(.name | test("(?i)(linux|ubuntu)"))
        | select(.name | test("(?i)(arm64|aarch64)") | not)
        | .browser_download_url
      '
      ;;
    aarch64|arm64)
      asset_filter='
        .assets[]
        | select(.name | test("(?i)appimage"))
        | select(.name | test("(?i)(linux|ubuntu)"))
        | select(.name | test("(?i)(arm64|aarch64)"))
        | .browser_download_url
      '
      ;;
    *)
      printf 'Unsupported architecture: %s\n' "${arch}" >&2
      exit 1
      ;;
  esac

  jq -r "${asset_filter}" | head -n1
}

main() {
  require_cmd jq
  require_cmd install
  require_cmd mktemp
  require_cmd uname

  local release_json tag_name asset_url tmp_file current_tag
  tmp_file=""
  release_json="$(fetch_release_json)"
  tag_name="$(jq -r '.tag_name' <<<"${release_json}")"
  asset_url="$(pick_asset_url <<<"${release_json}")"

  if [[ -z "${tag_name}" || "${tag_name}" == "null" ]]; then
    printf 'Could not determine latest stable release tag.\n' >&2
    exit 1
  fi

  if [[ -z "${asset_url}" || "${asset_url}" == "null" ]]; then
    printf 'Could not find a matching AppImage asset for %s.\n' "$(uname -m)" >&2
    exit 1
  fi

  current_tag=""
  if [[ -f "${STATE_PATH}" ]]; then
    current_tag="$(<"${STATE_PATH}")"
  fi

  if [[ "${current_tag}" == "${tag_name}" && -x "${TARGET_PATH}" ]]; then
    printf 'CrealityPrint is already up to date: %s\n' "${tag_name}"
    exit 0
  fi

  tmp_file="$(mktemp "${TMP_DIR}/CrealityPrint.AppImage.XXXXXX")"
  trap '[[ -n "${tmp_file:-}" ]] && rm -f "${tmp_file}"' EXIT

  if command -v gh >/dev/null 2>&1; then
    gh release download "${tag_name}" \
      --repo "${OWNER}/${REPO}" \
      --pattern "$(basename "${asset_url}")" \
      --output "${tmp_file}"
  else
    curl -fL "${asset_url}" -o "${tmp_file}"
  fi

  chmod 0755 "${tmp_file}"
  run_as_root install -m 0755 "${tmp_file}" "${TARGET_PATH}"
  printf '%s\n' "${tag_name}" | run_as_root tee "${STATE_PATH}" >/dev/null

  printf 'Installed %s to %s\n' "${tag_name}" "${TARGET_PATH}"
}

main "$@"
